{
  "name": "dsh-github-workflow",
  "version": "0.1.0",
  "description": "GitHub deep-workflow toolset for DeepSeek Harness agents: analyze issues, create high-quality draft PRs, review PRs, and check CI — with a fail-closed mutation guard (approval, read-only mode, token scopes).",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
